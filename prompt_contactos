final searchResultsProvider = FutureProvider<List<PerfilProfesionalModel>>((ref) async {
  final query = ref.watch(searchQueryProvider);
  final category = ref.watch(selectedCategoryProvider);
  final city = ref.watch(selectedCityProvider);
  
  var queryBuilder = SupabaseService.from('perfiles_profesionales')
      .select()
      .eq('activo', true)
      .eq('visible_busqueda', true);
  
  if (query.isNotEmpty) {
    queryBuilder = queryBuilder.or(
      'nombre_comercial.ilike.%$query%,descripcion.ilike.%$query%'
    );
