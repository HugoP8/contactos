async function activarRecarga(solicitudId) {
  const solicitud = await getSolicitud(solicitudId);
  
  // 1. Sumar créditos al usuario
  await supabase.rpc('incrementar_creditos', {
    user_id: solicitud.usuario_id,
    cantidad: solicitud.cantidad_creditos
  });

  // 2. Registrar transacción
  await supabase.from('transacciones').insert({
    usuario_id: solicitud.usuario_id,
    tipo: 'recarga_creditos',
    cantidad: solicitud.cantidad_creditos,
    monto_pagado: solicitud.monto,
    metodo_pago: solicitud.metodo_pago,
    cajero_id: solicitud.cajero_id,
    admin_id: adminId,
    estado: 'completada',
    timestamp: new Date()
  });

  // 3. Registrar comisión del cajero
  await supabase.from('comisiones_cajeros').insert({
    cajero_id: solicitud.cajero_id,
    monto: solicitud.monto * 0.05, // 5%
    solicitud_id: solicitudId,
    fecha: new Date()
  });

  // 4. Marcar solicitud como completada
  await supabase.from('solicitudes_recarga').update({
    estado: 'completada',
    fecha_activacion: new Date(),
    admin_activador: adminId
  }).eq('id', solicitudId);

  // 5. Notificar al usuario
  await sendPushNotification(solicitud.usuario_id, {
    title: '🎉 ¡Créditos activados!',
    body: `Se agregaron ${solicitud.cantidad_creditos} créditos a tu cuenta`,
  });

  // 6. Notificar al cajero
  await sendPushNotification(solicitud.cajero_id, {
    title: '✅ Recarga activada',
    body: `Ganaste Bs. ${(solicitud.monto * 0.05).toFixed(2)} de comisión`,
  });

  return { success: true };
}
```

